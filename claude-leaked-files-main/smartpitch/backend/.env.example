NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smartpitch

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub (Avoid Rate Limits on Repos)
GITHUB_TOKEN=your_github_personal_access_token_here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_HACKER_PRICE_ID=price_hacker_monthly
STRIPE_FOUNDER_PRICE_ID=price_founder_monthly
STRIPE_AGENCY_PRICE_ID=price_agency_monthly

# CamPay
CAMPAY_USERNAME=your_campay_username
CAMPAY_PASSWORD=your_campay_password
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_WEBHOOK_URL=https://yourdomain.com/api/payments/campay/webhook

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=SmartPitch <noreply@smartpitch.io>

# Admin
ADMIN_EMAIL=admin@smartpitch.io
ADMIN_PASSWORD=Admin@123ChangeMeNow
